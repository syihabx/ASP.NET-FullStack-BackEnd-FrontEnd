<div id="app" v-cloak data-key="Dashboard:Read">
    <div v-if="pageLoading" class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
        <indocontentloading />
    </div>
    <div v-else class="dashboard-container">
        <h4 class="dashboard-title">@ViewBag.Title</h4>

        <div class="row g-4">
            <!-- Vendor Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="stats-card bg-gradient-primary text-white text-center h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="bi bi-briefcase" style="font-size: 1.8rem;"></i>
                        </div>
                        <h5 class="mt-2 mb-1">Vendors</h5>
                        <p class="display-6 mb-0 fw-bold">{{ vendors.length }}</p>
                    </div>
                </div>
            </div>

            <!-- Customer Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="stats-card bg-gradient-success text-white text-center h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="bi bi-people" style="font-size: 1.8rem;"></i>
                        </div>
                        <h5 class="mt-2 mb-1">Customers</h5>
                        <p class="display-6 mb-0 fw-bold">{{ customers.length }}</p>
                    </div>
                </div>
            </div>

            <!-- Vendor Contact Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="stats-card bg-gradient-warning text-white text-center h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="bi bi-telephone" style="font-size: 1.8rem;"></i>
                        </div>
                        <h5 class="mt-2 mb-1">Vendor Contacts</h5>
                        <p class="display-6 mb-0 fw-bold">{{ vendorContacts.length }}</p>
                    </div>
                </div>
            </div>

            <!-- Customer Contact Card -->
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="stats-card bg-gradient-danger text-white text-center h-100">
                    <div class="card-body">
                        <div class="icon-wrapper">
                            <i class="bi bi-person-lines-fill" style="font-size: 1.8rem;"></i>
                        </div>
                        <h5 class="mt-2 mb-1">Customer Contacts</h5>
                        <p class="display-6 mb-0 fw-bold">{{ customerContacts.length }}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pie Chart Section -->
        <div class="row g-4">
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-pie-chart me-2"></i>Contacts per Customer</h4>
                    </div>
                    <div class="card-body">
                        <div ref="pieChart" class="chart-container"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-pie-chart-fill me-2"></i>Contacts per Vendor</h4>
                    </div>
                    <div class="card-body">
                        <div ref="ringChart" class="chart-container"></div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Gauge Chart Section -->
        <div class="row g-4">
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-speedometer me-2"></i>Customer Contact Distribution</h4>
                    </div>
                    <div class="card-body">
                        <div ref="gaugeChartCustomer" class="chart-container"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-speedometer2 me-2"></i>Vendor Contact Distribution</h4>
                    </div>
                    <div class="card-body">
                        <div ref="gaugeChartVendor" class="chart-container"></div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Bar Chart Section -->
        <div class="row g-4">
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-bar-chart me-2"></i>Contacts per Customer</h4>
                    </div>
                    <div class="card-body">
                        <div ref="barChartCustomer" class="chart-container"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="chart-card">
                    <div class="card-header">
                        <h4><i class="bi bi-bar-chart-fill me-2"></i>Contacts per Vendor</h4>
                    </div>
                    <div class="card-body">
                        <div ref="barChartVendor" class="chart-container"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


