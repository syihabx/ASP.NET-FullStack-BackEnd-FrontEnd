@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Indotalent - @ViewBag.Title</title>

    @* css *@
    <link rel="stylesheet" href="~/libs/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/libs/bootstrap/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="~/libs/bootstrap/dist/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/src/Theme/Content.css" />
    @await RenderSectionAsync("styles", required: false)
    <style>
        [v-cloak] {
            display: none !important;
        }
    </style>

    @* javascript *@
    <script async src="/libs/esmoduleshims/es-module-shims.min.js"></script>
    <script type="importmap">
        {
          "imports": {
            "vue": "/libs/vue/vue.esm-browser.prod.js",
            "indosearchbox": "/src/Components/indosearchbox.js",
            "indotable": "/src/Components/indotable.js",
            "indobutton": "/src/Components/indobutton.js",
            "indoskeleton": "/src/Components/indoskeleton.js",
            "indoloading": "/src/Components/indoloading.js",
            "indocontentloading": "/src/Components/indocontentloading.js",
            "useAxios": "/src/Composables/useAxios.js",
            "useStorageManager": "/src/Composables/useStorageManager.js",
            "useAccessManager": "/src/Composables/useAccessManager.js",
            "usePagedList": "/src/Composables/usePagedList.js",
            "useClientSideSorting": "/src/Composables/useClientSideSorting.js",
            "contentRouter": "/src/Theme/ContentRouter.js"
          }
        }
    </script>
    <script src="~/libs/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/libs/axios/axios.min.js" defer></script>
    <script src="~/libs/sweetalert/sweetalert2v11.js" defer></script>
    <script src="~/libs/echarts/echarts.min.js" defer></script>
    <script src="~/src/Theme/Content.js" defer></script>


</head>
<body>

    <div class="sidebar" id="sidebar">
        <!-- Sidebar header with logo -->
        <div class="sidebar-top" id="toggleSidebar">
            <div class="d-flex align-items-center">
                <i class="bi bi-box icon-logo"></i>
                <h4 class="mb-0 brand-text">INDOTALENT</h4>
            </div>
            <i class="bi bi-chevron-left ms-auto sidebar-toggle-icon"></i>
        </div>

        <!-- User profile section -->
        <div class="user-info">
            <div class="d-flex align-items-center">
                <div class="avatar-circle">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="ms-2">
                    <p class="mb-0 fw-bold" id="username">Username</p>
                    <small class="text-muted">Administrator</small>
                </div>
            </div>
        </div>

        <!-- Menu items -->
        <div class="menu">
            <!-- JavaScript will inject menu items here -->
        </div>
    </div>


    <div class="main-content" id="main-content">

        <!-- Header section -->
        <div class="header">
            <div class="d-flex align-items-center">
                <button class="btn btn-sm mobile-menu-toggle d-block d-lg-none me-3">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h2 class="header-title">@ViewBag.Title</h2>
            </div>

            <div class="d-flex align-items-center">
                <!-- Notifications button -->
                <div class="position-relative me-3">
                    <button class="btn btn-light btn-sm rounded-circle">
                        <i class="bi bi-bell"></i>
                    </button>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        2
                    </span>
                </div>

                <!-- User dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm user-dropdown" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="d-none d-md-inline-block me-2" id="headerUsername">UserName</span>
                        <div class="avatar-circle avatar-circle-sm">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                        <li><button class="dropdown-item"><i class="bi bi-person-circle me-2"></i>Profile</button></li>
                        <li><button class="dropdown-item"><i class="bi bi-gear me-2"></i>Settings</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/Accounts/Logout"><i class="bi bi-door-open-fill me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Content loading indicator -->
        <div id="content-loading" class="hidden">
            <div class="d-flex flex-column align-items-center justify-content-center" style="height: 100%;">
                <div class="spinner-border text-primary mb-2" style="width: 3rem; height: 3rem;" role="status"></div>
                <div class="mt-2 text-primary fw-bold">Memuat konten...</div>
            </div>
        </div>

        <!-- Body section -->
        <div class="body-content">
            <!-- Dynamic content area -->
            <div id="dynamic-content">
                @RenderBody()
            </div>
        </div>

        <!-- Footer section -->
        <footer class="footer">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    &copy; @DateTime.Now.Year INDOTALENT
                </div>
                <div class="d-flex">
                    <span>Active Config: <span id="activeConfig"></span></span>
                    <span class="mx-2">|</span>
                    <span>Currency: <span id="activeCurrency"></span></span>
                    
                    @if (Configuration.GetValue<bool>("EnableSwaggerInProduction"))
                    {
                        <span class="mx-2">|</span>
                        <a href="/swagger" target="_blank">Swagger</a>
                    }
                </div>
            </div>
        </footer>
    </div>

    <style>
        .avatar-circle {
            width: 40px;
            height: 40px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .avatar-circle i {
            font-size: 1.3rem;
            color: #fff;
        }

        .avatar-circle-sm {
            width: 32px;
            height: 32px;
        }

        .avatar-circle-sm i {
            font-size: 1rem;
        }

        .sidebar-toggle-icon {
            color: rgba(255, 255, 255, 0.5);
            font-size: 1rem;
            transition: all 0.3s;
        }

        .sidebar.closed .sidebar-toggle-icon {
            transform: rotate(180deg);
        }

        .user-dropdown {
            display: flex;
            align-items: center;
            background: transparent;
            border: none;
            color: #333;
        }

        .user-dropdown:hover {
            background-color: #f0f4ff;
        }

        .mobile-menu-toggle {
            background: transparent;
            border: none;
            color: #333;
        }

        .mobile-menu-toggle:hover {
            background-color: #f0f4ff;
        }

        @media (max-width: 992px) {
            .sidebar.closed {
                transform: translateX(-100%);
            }
            .sidebar {
                transform: translateX(0);
            }
        }
    </style>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
